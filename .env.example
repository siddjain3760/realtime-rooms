# Copy to .env and fill in real values before deploying.
# WebSocket clients must pass this as ?token=... to connect.
HUB_TOKEN=dev-token-change-me
# Required in the X-Admin-Token header for POST /rooms/{id}/broadcast.
ADMIN_TOKEN=dev-admin-change-me
# How many past messages a room replays to new joiners.
MAX_HISTORY=50
# Per-connection rate limit: N messages per window.
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=10.0
PORT=8000
